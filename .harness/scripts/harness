#!/usr/bin/env bash

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ROOT_DIR="$(cd "$SCRIPT_DIR/../.." && pwd)"
cd "$ROOT_DIR"

usage() {
  cat <<'USAGE'
用法:
  .harness/scripts/harness status [--json]
  .harness/scripts/harness sync-candidates
  .harness/scripts/harness verify <change> [--no-probe]
  .harness/scripts/harness close <change> [--skip-specs] [--no-probe]
  .harness/scripts/harness reset-current

说明:
  status 一次输出会话恢复所需的执行状态：active 槽、候选 change 与 lifecycle
         phase、blocker、next action、任务进度、证据数量、漂移告警和最近提交。
  sync-candidates 按 openspec/changes/ 的实际内容重写候选集合；候选成员关系
         不由人工维护，per-change context 原样保留。
  verify 负责 OpenSpec 严格校验、变更级质量文件检查、仓库结构检查（文档引用
         路径、skill 一致性、feature-index 同步），并按 quality-contract.md
         的「必须验证」决定是否执行 Unity 环境探针。
  close 在 verify 通过后检查 tasks、human checks，再执行 openspec archive。
  reset-current 清空 .harness/current.json，只保留可恢复的空执行槽。

选项:
  --json        status 以 JSON 输出，供脚本消费。
  --no-probe    人工覆盖：即使质量契约要求，也跳过 Unity 环境探针。
  --skip-specs  归档时跳过 spec 更新，用于 infra、工具或纯文档变更。
USAGE
}

fail() {
  echo "错误: $*" >&2
  exit 1
}

require_command() {
  command -v "$1" >/dev/null 2>&1 || fail "缺少命令: $1"
}

change_dir() {
  local change="$1"
  echo "openspec/changes/$change"
}

require_change_files() {
  local change="$1"
  local dir
  dir="$(change_dir "$change")"

  [ -d "$dir" ] || fail "找不到变更目录: $dir"
  [ -f "$dir/tasks.md" ] || fail "缺少 $dir/tasks.md"
  [ -f "$dir/quality-contract.md" ] || fail "缺少 $dir/quality-contract.md，请从 .harness/templates/quality-contract.md 复制"
  [ -f "$dir/verification.md" ] || fail "缺少 $dir/verification.md，请从 .harness/templates/verification.md 复制"
  [ -f "$dir/human-checks.md" ] || fail "缺少 $dir/human-checks.md，请从 .harness/templates/human-checks.md 复制"
}

check_tasks_complete() {
  local change="$1"
  local tasks_file
  tasks_file="$(change_dir "$change")/tasks.md"

  if grep -Eq '^[[:space:]]*-[[:space:]]*\[[[:space:]]\]' "$tasks_file"; then
    fail "$tasks_file 仍有未完成任务"
  fi
}

check_human_checks_clear() {
  # 正向断言：表格必须存在、至少一行、每行状态为 passed 或 waived、waived 有豁免记录。
  # 判定逻辑在 harness_checks.py，保证两个平台结论一致。
  "$(resolve_python)" .harness/scripts/harness_checks.py human-checks "$1"
}

check_quality_docs_decision() {
  local change="$1"
  local verification_file
  verification_file="$(change_dir "$change")/verification.md"

  if ! grep -Eq '^##[[:space:]]+质量文档判断[[:space:]]*$' "$verification_file"; then
    fail "$verification_file 缺少“质量文档判断”章节；请按 docs/quality/README.md 判断是否需要更新 scorecard、tech-debt、risks 或 knowledge 文档"
  fi
}

resolve_python() {
  if command -v python3 >/dev/null 2>&1; then
    echo python3
  elif command -v python >/dev/null 2>&1; then
    echo python
  else
    fail "缺少命令: python3"
  fi
}

show_status() {
  local as_json="$1"
  local python_bin
  python_bin="$(resolve_python)"

  # 状态投影与 dashboard 共用 .harness/scripts/harness_state.py，不在此重复实现。
  if [ "$as_json" = "1" ]; then
    "$python_bin" .harness/scripts/harness_state.py status --json
  else
    "$python_bin" .harness/scripts/harness_state.py status
  fi
}

verify_change() {
  local change="$1"
  local no_probe="$2"
  local python_bin
  python_bin="$(resolve_python)"

  require_command openspec
  require_change_files "$change"

  echo "==> OpenSpec 严格校验: $change"
  openspec validate "$change" --strict

  echo "==> 仓库结构检查"
  "$python_bin" .harness/scripts/harness_checks.py doc-refs
  "$python_bin" .harness/scripts/harness_checks.py skills
  "$python_bin" .harness/scripts/sync-feature-index.py --check

  if [ "$no_probe" = "1" ]; then
    echo "==> 环境探针: 跳过（--no-probe）"
  elif "$python_bin" .harness/scripts/harness_checks.py probe-needed "$change"; then
    echo "==> 基础环境探针"
    # verify 已经跑过 openspec validate，探针无需再列一次变更。
    SKIP_OPENSPEC_LIST=1 bash ./init.sh
  fi

  echo "==> verify 完成: $change"
}

close_change() {
  local change="$1"
  local skip_specs="$2"
  local no_probe="$3"

  verify_change "$change" "$no_probe"
  check_tasks_complete "$change"
  check_human_checks_clear "$change"
  check_quality_docs_decision "$change"

  echo "==> 归档变更: $change"
  # -y 保证在无终端输入的 agent 会话中不会卡在交互确认上。
  if [ "$skip_specs" = "1" ]; then
    openspec archive "$change" -y --skip-specs
  else
    openspec archive "$change" -y
  fi

  echo "==> 收尾 current.json"
  finalize_close "$change"

  # 归档会把 delta spec 落进 openspec/specs/，能力索引随之过期；不在这里同步，
  # 下一次 verify 必然在 sync-feature-index --check 处失败。
  echo "==> 同步能力索引"
  "$(resolve_python)" .harness/scripts/sync-feature-index.py

  echo "==> close 完成: $change"
}

reset_current() {
  # schema 定义只存在于 harness_state.py，两个平台脚本都不再各写一份字面量 JSON。
  "$(resolve_python)" .harness/scripts/harness_state.py reset-current
}

sync_candidates() {
  "$(resolve_python)" .harness/scripts/harness_state.py sync-candidates
}

finalize_close() {
  "$(resolve_python)" .harness/scripts/harness_state.py finalize-close "$1"
}

command_name="${1:-}"
shift || true

change=""
skip_specs=0
as_json=0
no_probe=0

while [ "$#" -gt 0 ]; do
  case "$1" in
    --skip-specs)
      skip_specs=1
      ;;
    --json)
      as_json=1
      ;;
    --no-probe)
      no_probe=1
      ;;
    -*)
      usage
      fail "未知选项: $1"
      ;;
    *)
      [ -z "$change" ] || { usage; fail "只能指定一个 change: $change / $1"; }
      change="$1"
      ;;
  esac
  shift
done

if [ -z "$command_name" ]; then
  usage
  exit 2
fi

if [ "$skip_specs" = "1" ] && [ "$command_name" != "close" ]; then
  usage
  fail "--skip-specs 只能与 close 一起使用"
fi

if [ "$as_json" = "1" ] && [ "$command_name" != "status" ]; then
  usage
  fail "--json 只能与 status 一起使用"
fi

if [ "$no_probe" = "1" ] && [ "$command_name" != "verify" ] && [ "$command_name" != "close" ]; then
  usage
  fail "--no-probe 只能与 verify 或 close 一起使用"
fi

case "$command_name" in
  status)
    [ -z "$change" ] || { usage; fail "status 不接受 change 参数"; }
    show_status "$as_json"
    ;;
  sync-candidates)
    [ -z "$change" ] || { usage; fail "sync-candidates 不接受 change 参数"; }
    sync_candidates
    ;;
  verify)
    [ -n "$change" ] || { usage; fail "verify 需要 <change>"; }
    verify_change "$change" "$no_probe"
    ;;
  close)
    [ -n "$change" ] || { usage; fail "close 需要 <change>"; }
    close_change "$change" "$skip_specs" "$no_probe"
    ;;
  reset-current)
    reset_current
    ;;
  help|--help|-h)
    usage
    ;;
  *)
    usage
    fail "未知命令: $command_name"
    ;;
esac
